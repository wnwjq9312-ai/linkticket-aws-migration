
# LINKTICKET AWS WAS environment template
# Example only. Do not store real secrets in Git.

# Django
DJANGO_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_KEY
DJANGO_ALLOWED_HOSTS=ticket.woong.click
CSRF_TRUSTED_ORIGINS=https://ticket.woong.click

# AWS RDS MariaDB
DB_ENGINE=mysql
DB_HOST=REPLACE_WITH_RDS_ENDPOINT
DB_PORT=3306
DB_NAME=ticketing_db
DB_USER=ticket_app
DB_PASSWORD=REPLACE_WITH_DB_PASSWORD

# Redis
REDIS_URL=redis://REPLACE_WITH_REDIS_HOST:6379/0
SESSION_REDIS_DB=0

# Static and shared media storage
STATIC_ROOT=/var/www/ticket_app/staticfiles
MEDIA_ROOT=/mnt/linkticket-media
WEB_NFS_MOUNT=/mnt/linkticket-media

# Optional production settings
NFT_UPLOADS_ENABLED=False
SECURE_HSTS_SECONDS=0
