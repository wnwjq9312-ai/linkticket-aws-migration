# Copy outside the repository to /etc/linkticket/linkticket.env, mode 0600.
DJANGO_SETTINGS_MODULE=config.settings_production
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=
DB_ENGINE=mysql
DB_NAME=ticketing_db
DB_USER=ticket_app
DB_PASSWORD=
DB_HOST=10.10.2.5
DB_PORT=4006
STATIC_ROOT=/var/www/ticket_app/staticfiles
# Fill only after checking existing mounts; do not create new exports blindly.
WEB_NFS_MOUNT=
MEDIA_ROOT=
NFT_NFS_MOUNT=
NFT_MEDIA_ROOT=
REDIS_URL=
# Identical on both WAS nodes, even when general Redis URLs use different DBs.
SESSION_REDIS_DB=0
KAKAO_MAP_JS_KEY=
SECURE_HSTS_SECONDS=0
# WAS-1: 10.10.2.2:8000; WAS-2: 10.10.2.4:8080
GUNICORN_BIND=

# Defer NFT writes until its mount and serving path have been verified.
NFT_UPLOADS_ENABLED=False
NFT_MEDIA_URL=
