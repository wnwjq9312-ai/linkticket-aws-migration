# LINKTICKET AWS Compute Configuration
# Region: ap-northeast-2
# VPC: 10.0.0.0/16
#
# Existing VPC, APP subnets and WEB/WAS security groups
# are automatically discovered in data.tf.
#
# WEB-1: Private APP AZ-a (10.0.11.0/24)
# WAS-1: Private APP AZ-c (10.0.12.0/24)
#
# Replace the AMI ID and IAM Instance Profile with real values.
# Do not commit credentials or sensitive configuration.

project_name = "LINKTICKET"
environment  = "prd"

ami_id        = "ami-REPLACE_WITH_VALID_AMI_ID"
instance_type = "t3.micro"

instance_profile_name = "REPLACE_WITH_INSTANCE_PROFILE"

web_instance_count = 1
was_instance_count = 1
