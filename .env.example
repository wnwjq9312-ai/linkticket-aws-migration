# 이 파일을 복사해서 같은 폴더에 ".env"로 저장하고 값을 채운다.
#   cp .env.example .env
# .env는 .gitignore에 이미 포함되어 있어 git에 절대 올라가지 않는다 — 실제 비밀번호/IP는
# 이 예시 파일이 아니라 .env에만 적는다.

# ── 기본(팀 확정 DB) — MariaDB에 연결 ─────────────────────────────────
# DB_ENGINE을 안 적어도 기본값이 mysql이다. 아래 4개 값만 채우면 된다.
DB_HOST=<DB를 들고 있는 조원 PC의 사설 IP, 예: 192.168.0.23>
DB_PORT=3306
DB_NAME=linkticket
DB_USER=linkticket_app
DB_PASSWORD=<DB 담당 조원에게 받은 비밀번호>

# ── 예외) DB 서버 없이 화면 UI만 잠깐 보고 싶을 때 ──────────────────────
# 위 4줄을 지우고 아래 한 줄만 남기면, 로컬 파일(db.sqlite3) 기반으로 돈다.
# 팀 공유 DB와는 완전히 별개의 데이터이며, 정식 검증 용도가 아니다.
# DB_ENGINE=sqlite

# ── 선택 항목 (안 채우면 개발용 기본값 사용) ────────────────────────────
# DJANGO_SECRET_KEY=
# DJANGO_DEBUG=True
# DJANGO_ALLOWED_HOSTS=*
# REDIS_URL=redis://127.0.0.1:6379/0

# 공연장 지도: JavaScript 키를 환경변수로 공급한다. 미설정 시 주소 안내를 표시한다.
# KAKAO_MAP_JS_KEY=
